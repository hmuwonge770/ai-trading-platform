{
  "name": "ai-trading-platform/control-dashboard",
  "type": "project",
  "description": "Laravel control dashboard for the AI Trading Platform.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
